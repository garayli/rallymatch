{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "rallymatch",
          "appId": "1:454097941276:android:304942847955b8dae580d9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "rallymatch",
          "configurations": {
            "android": "1:454097941276:android:304942847955b8dae580d9",
            "ios": "1:454097941276:ios:1c5e42afb1519a80e580d9",
            "web": "1:454097941276:web:d4bae53a081c7e02e580d9"
          }
        }
      }
    }
  },
  "hosting": {
    "target": "macagel",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|flutter_bootstrap.js|main.dart.js|flutter_service_worker.js|manifest.json|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
